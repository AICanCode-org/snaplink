# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.
# Every track reads exactly these variables.

# --- app (used when you run a track directly on your machine with `make run`) ---
DATABASE_URL=postgresql://snaplink:snaplink@localhost:5432/snaplink
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
# MIGRATIONS_DIR defaults to ../../spec/db/migrations when run from tracks/<track>

# --- ports published by docker compose (change if something else uses them) ---
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- AI insights (Phase 3 M5). Default: offline template, no key needed. ---
# Model names and free-tier limits change often: check the provider docs before you copy these.
INSIGHTS_PROVIDER=template
# Local + free + offline after the first download:   docker compose --profile ollama up -d
#   INSIGHTS_PROVIDER=llm  LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=llama3.2:1b
# Google Gemini free tier (OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Groq free tier:
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=
LLM_TIMEOUT_MS=5000
